{
  /* Worker 名字 = 部署单元的唯一 ID。2026-10-02 之前本仓库与博客仓库的
     cf-deploy/ 都叫 "bobing"，谁后部署谁覆盖对方（游戏一上线就把博客盖掉）。
     两个站点现在拆成两个 Worker：这里是游戏，博客是 rhinelab-blog。
     改名只需要改这里，路由在下面的 routes。 */
  "name": "bobing-game",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    /* 这些路径必须先过 Worker（否则静态资源优先命中，`/` 会直接吐出 index.html，
       而不是 Worker 里写好的 302 → /bobing）。线上实际就是这个值，此前漏提交了。 */
    "run_worker_first": ["/bobing", "/bobing/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  /* 路由收窄到游戏路径：根路径与其他一切路径放行给博客（2026-10-02 博客上线，
     此前 woo3an.top/* 全域接管把博客盖掉了）。改这里 = 改线上路由，别只改控制台。 */
  "routes": [
    { "pattern": "woo3an.top/bobing*", "zone_name": "woo3an.top" },
    { "pattern": "woo3an.top/ws", "zone_name": "woo3an.top" }
  ]
}
